# =========================================
# Finova Budget Tracker — Environment Sample
# Copy this file to .env and fill in real values.
# =========================================

# --- NeonDB / PostgreSQL ---
# Get these from https://console.neon.tech → your project → Connection Details
# IMPORTANT: ensure `sslmode=require` is in the JDBC URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/finova_db?sslmode=require
SPRING_DATASOURCE_USERNAME=finova_user
SPRING_DATASOURCE_PASSWORD=replace-with-neon-password

# --- JWT ---
# Use a long random string. Recommended: openssl rand -base64 64
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# --- Admin bootstrap (seeded on first run) ---
ADMIN_EMAIL=admin@finova.io
ADMIN_PASSWORD=Admin@12345

# --- App ---
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
